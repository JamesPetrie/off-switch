#!/usr/bin/env bash

# Must be sourced (not executed)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "ERROR: This script must be sourced: source ${BASH_SOURCE[0]}" >&2
  exit 1
fi

# Path to the standard-cell library (Liberty format).
# Override this to point to your library file.
export CELL_LIB=""

# Name of the NAND2 cell in the library.
# Override this to match your library.
export NAND2_CELL=""

# Name of the FO4 reference cell in the library.
# Override this to match your library.
export FO4_CELL=""

# Target clock period in picoseconds (ps).
# Override this to set your desired clock frequency.
export TARGET_PERIOD_PS=
